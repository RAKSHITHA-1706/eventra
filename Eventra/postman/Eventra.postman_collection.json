{
  "info": {
    "name": "Eventra API Tests",
    "_postman_id": "a1ed91b7-9c22-4ac2-8d45-1c8ef011ee13",
    "description": "API smoke and edge-case tests for Eventra. Set baseUrl and token variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "tierId",
      "value": "1"
    },
    {
      "key": "reservationId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('API healthy',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Login attendee",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"attendee@eventra.demo\", \"password\": \"DemoPass123!\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login succeeds',()=>pm.response.to.have.status(200));",
              "const d=pm.response.json(); if(d.token) pm.collectionVariables.set('token',d.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "List events",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/events"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Events returned',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create reservation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/reservations",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tier_id\": {{tierId}},\n  \"quantity\": 1\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Reservation created or inventory conflict reported',()=>pm.expect([201,409]).to.include(pm.response.code));",
              "if(pm.response.code===201) pm.collectionVariables.set('reservationId',pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Pay reservation (mock async)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/reservations/{{reservationId}}/pay",
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Payment queued or rejected for expired hold',()=>pm.expect([202,404,409]).to.include(pm.response.code));"
            ]
          }
        }
      ]
    },
    {
      "name": "Expired or invalid reservation ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/reservations/00000000-0000-4000-8000-000000000000"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Unknown reservation returns 404',()=>pm.response.to.have.status(404));"
            ]
          }
        }
      ]
    },
    {
      "name": "Concurrent reservation smoke test",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/reservations",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tier_id\": {{tierId}},\n  \"quantity\": 10\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('No server error during competing reservation',()=>pm.expect([201,409]).to.include(pm.response.code));"
            ]
          }
        }
      ]
    }
  ]
}